{
  "manifest_version": 2,
  "name": "Tabs De Clutter",
  "version": "1.0",
  "description": "Close duplicate tabs and bookmark window all tabs to catch up later",
  "permissions": ["tabs", "bookmarks", "storage", "contextMenus", "downloads"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@tabs_de_clutter",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon.png"
  }
}
